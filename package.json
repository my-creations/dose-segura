{
  "name": "dose-segura",
  "description": "Dose Segura Application",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "homepage": "https://my-creations.github.io/dose-segura",
  "scripts": {
    "deploy": "gh-pages -d dist --dotfiles",
    "verify:deploy": "node scripts/verify-web-deploy.js",
    "predeploy": "bun run build:web",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "preweb": "bun run validate:meds",
    "web": "expo start --web",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type-check": "tsc --noEmit",
    "lint:meds": "node scripts/sort-meds-json.js --check",
    "lint:meds:fix": "node scripts/sort-meds-json.js --fix",
    "generate:meds": "node scripts/medication-artifacts.js sync",
    "validate:meds": "node scripts/medication-artifacts.js check",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:single": "jest",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "test:all": "bun run test && bun run e2e",
    "prebuild:web": "bun run validate:meds",
    "build:web": "node scripts/run-web-export.js && node scripts/fix-web-build.js",
    "build:android": "eas build -p android",
    "build:ios": "eas build -p ios",
    "prepare": "husky",
    "generate:infarmed-coverage": "node scripts/generate-infarmed-coverage.js"
  },
  "dependencies": {
    "@expo-google-fonts/quicksand": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.11",
    "expo-localization": "^17.0.8",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "i18n-js": "^4.5.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.8.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.5",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.4",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "@tootallnate/once": "^3.0.1"
  },
  "private": true,
  "packageManager": "bun@1.3.10"
}

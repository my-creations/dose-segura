{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "jsxSingleQuote": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    ".expo",
    "dist",
    "web-build",
    "coverage",
    "playwright-report",
    "blob-report",
    "test-results",
    ".pi/tasks",
    "ios",
    "android",
    "package-lock.json",
    "yarn.lock",
    "expo-env.d.ts",
    "data/meds.json",
    "data/meds-index.json",
    "infarmed",
    "medication-images",
    "venv",
    "public/meds-full.json"
  ]
}
